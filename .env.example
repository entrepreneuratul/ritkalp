# =====================================================================
# Copy this to .env for local dev (already done — see .env, gitignored).
# In production, set every one of these as a Vercel project environment
# variable (Project Settings → Environment Variables) — never commit
# real secrets to git.
# =====================================================================

# Postgres connection string. Local dev: a local Postgres (see README).
# Production: your Neon project's connection string.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Auth.js session-signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Razorpay (Dashboard → Settings → API Keys). Use Test Mode keys until
# your business KYC is approved for Live Mode — the site works the same
# either way, only real money moves in Live Mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks → (create one pointing at
# https://<your-domain>/api/webhooks/razorpay) → its "Secret".
RAZORPAY_WEBHOOK_SECRET=""
# Same value as RAZORPAY_KEY_ID — exposed to the browser (NEXT_PUBLIC_)
# because Razorpay Checkout.js needs it client-side; the secret key
# never is.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Resend (resend.com) — order confirmation + new-order alert emails.
RESEND_API_KEY=""
# Business owner's inbox — receives a "new order" email for every order.
BUSINESS_NOTIFY_EMAIL=""
# Must be a sender address on a domain you've verified with Resend.
EMAIL_FROM="Ritkalp <orders@yourdomain.com>"

# =====================================================================
# Inventoryfy — Ritkalp's stock/price master (see README's "Inventory
# model" section). INVENTORYFY_API_KEY / INVENTORYFY_WEBHOOK_SECRET are
# written automatically by `npm run sync:inventoryfy` the first time you
# run it (a one-time-reveal from Inventoryfy — that script is what makes
# these appear, don't fill them in by hand). The others are inputs to
# that same script.
# =====================================================================
INVENTORYFY_API_URL="http://localhost:3001"
INVENTORYFY_API_KEY=""
INVENTORYFY_WEBHOOK_SECRET=""
# Owner login sync:inventoryfy authenticates with to create/update the
# catalog in Inventoryfy (creating products needs a real login, not the
# storefront API key above, which is order/read-only by design).
INVENTORYFY_OWNER_EMAIL="owner@inventoryfy.dev"
INVENTORYFY_OWNER_PASSWORD="password123"
INVENTORYFY_BUSINESS_NAME="Ritkalp"
# Where Inventoryfy should send its inventory webhook — Ritkalp's own
# public URL. Local dev: leave as localhost:3000. Production: your real
# deployed domain.
RITKALP_PUBLIC_URL="http://localhost:3000"

# Releases stock for abandoned/failed Razorpay checkouts (never touches
# WhatsApp orders — see app/api/cron/release-stale-orders/route.ts).
# CRON_SECRET: generate with `openssl rand -base64 32` — Vercel
# automatically sends it as a Bearer token on scheduled cron
# invocations once this env var is set (see vercel.json). Leave blank
# locally; the route just warns instead of rejecting when unset.
CRON_SECRET=""
# How long an ONLINE_PAYMENT order can sit UNPAID before its stock is
# released back.
STALE_ORDER_MINUTES="30"
